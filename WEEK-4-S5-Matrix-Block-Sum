class Solution {
    public int[][] matrixBlockSum(int[][] mat, int k) {
        int m = mat.length;
        int n = mat[0].length;
        
        // 1. Build the 2D Prefix Sum matrix
        // pref[i][j] will store the sum of elements in mat[0...i-1][0...j-1]
        int[][] pref = new int[m + 1][n + 1];
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                pref[i + 1][j + 1] = mat[i][j] + pref[i][j + 1] + pref[i + 1][j] - pref[i][j];
            }
        }
        
        int[][] answer = new int[m][n];
        
        // 2. Calculate the block sum for each element
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                // Define the bounding box coordinates, keeping them within matrix limits
                int r1 = Math.max(0, i - k);
                int c1 = Math.max(0, j - k);
                int r2 = Math.min(m - 1, i + k);
                int c2 = Math.min(n - 1, j + k);
                
                // Use the 2D prefix sum formula to calculate the submatrix sum in O(1)
                // We shift indices by +1 because pref is 1-indexed relative to mat
                answer[i][j] = pref[r2 + 1][c2 + 1] - pref[r1][c2 + 1] - pref[r2 + 1][c1] + pref[r1][c1];
            }
        }
        
        return answer;
        
    }
}
