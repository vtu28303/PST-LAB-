class Solution {
    public int[] buildArray(int[] nums) {
        // Create an answer array of the same length
        int[] ans = new int[nums.length];
        
        // Loop through each index and apply the formula
        for (int i = 0; i < nums.length; i++) {
            ans[i] = nums[nums[i]];
        }
        
        return ans;
        
    }
}
