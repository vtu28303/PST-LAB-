import java.time.LocalTime;
import java.time.format.DateTimeFormatter;
import java.util.Locale;

public class Solution {

    public static String timeConversion(String s) {
        // Define the input format (12-hour clock with AM/PM)
        DateTimeFormatter inputFormatter = DateTimeFormatter.ofPattern("hh:mm:ssa", Locale.ENGLISH);
        
        // Define the output format (24-hour clock)
        DateTimeFormatter outputFormatter = DateTimeFormatter.ofPattern("HH:mm:ss");
        
        // Parse the input string to a LocalTime object and format it to the 24-hour string
        LocalTime time = LocalTime.parse(s, inputFormatter);
        return time.format(outputFormatter);
    }

    public static void main(String[] args) {
        // Sample Input
        String input = "07:05:45PM";
        
        // Function Call
        String result = timeConversion(input);
        
        // Sample Output: 19:05:45
        System.out.println(result); 
    }
}
